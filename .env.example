# ── real_agent（小梦）环境变量（全部以 REAL_ 前缀）──
# 复制为 .env 后填入真实值。config.py 用 python-dotenv 自动加载。

# 大模型 API Key（二选一或都配；DeepSeek 支持多把逗号分隔轮换）
REAL_DEEPSEEK_API_KEYS=sk-xxx,sk-yyy        # DeepSeek 多 key，逗号分隔（可选）
REAL_DEEPSEEK_API_KEY=sk-xxx                # DeepSeek 单 key
REAL_OPENAI_API_KEY=                        # Kimi / OpenAI 兼容 key
REAL_OPENAI_BASE_URL=https://api.openai.com/v1
REAL_OPENAI_MODEL=kimi-k2.6

# 默认模型 / 分档模型（留空则沿用默认）
REAL_UNDERSTANDING_MODEL=
REAL_SYNTHESIS_MODEL=

# 地图（前端 /config 下发；不配则地图功能关闭）
REAL_TENCENT_MAP_KEY=
REAL_AMAP_JS_KEY=
REAL_AMAP_WEB_SERVICE_KEY=

# 小程序登录态（调试用默认 mpsessid；正式由前端每次请求带）
REAL_MEMBER_MPSESSID=

# 语义路由阈值（默认即线上值，一般不改）
REAL_ENABLE_SEMANTIC_ROUTER=true
REAL_SEMANTIC_ROUTER_HIGH=0.82
REAL_SEMANTIC_ROUTER_MEDIUM=0.65
REAL_SEMANTIC_ROUTER_MARGIN=0.08

# 数据目录（默认 real_agent/data）
REAL_DATA_DIR=

# RAG 向量库（可选）
REAL_MILVUS_PATH=
REAL_EMBED_API_KEY=
# HF_TOKEN=                                 # 本地 BGE embedding 用

REAL_AGENT_NAME=小梦
